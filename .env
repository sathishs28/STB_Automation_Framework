# .env to version control
CUSTOMER=tccl

# ── Active device profile ────────────────────────────
STB_DEVICE_TYPE=stb
DEVICE_BACKEND=ir

# ── IR backend ──────────────────────────
# Redrat Device Setup
REDRAT_DEVICE_ID=RedRat-X%2024103
REDRAT_DEVICE_NAME='RedRat-X 24103'
REDRAT_OUTPUT_PORT=4

# RedRat Hub Setup
REDRAT_HUB_URL=http://127.0.0.1:8081
REDRAT_HUB_DIR=setup_files/IR_blaster/RedRatHub-V8.01
# HTTP request timeout
REDRAT_TIMEOUT_MS=5000
# retries on transmit failure
REDRAT_RETRY_COUNT=3
# Dataset means, Remote control IR signals database.
REDRAT_DATASET=OVT_NXT_Digital_Remote
# Specify folders or files separated by semicolon. Directories will be expanded to all *.xml files.
REDRAT_IRDATA_FILES=assets/ir_signals_redrat

# ── Capture Setup ────────────────────────────────
CAPTURE_DEVICE_INDEX=0
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
CAPTURE_FPS=30

# ── Analysis - OCR Setup ─────────────────────────
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Framework - Logging, Evidnetces, reports, etc.
# For Debug Purpose only change INFO to DEBUG, after revert it back INFO
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING
EVIDENCE_DIR=evidence/                  # Screenshots and clips
REPORTS_DIR=reports/                    # Test execution reports